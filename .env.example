# Google OAuth — créer un projet sur https://console.cloud.google.com/
# APIs & Services > Credentials > Create OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173 (et votre domaine de prod)
VITE_GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com

# Emails autorisés à se connecter (séparés par des virgules)
VITE_ALLOWED_EMAILS=votre.email@gmail.com,autre@example.com

# --- Ports ---
# Serveur de dev Vite (frontend), côté hôte et conteneur
FRONTEND_PORT=5173
# Port de l'API Omnivoice exposé sur l'hôte (celui contacté par le navigateur)
API_HOST_PORT=5172
# Port interne de Flask dans le conteneur de l'API
API_INTERNAL_PORT=5000

# URL de l'API appelée par le navigateur.
# En docker-compose : http://localhost:${API_HOST_PORT} (ex. 5172).
# En local sans docker (python app.py direct) : http://localhost:5000
VITE_API_BASE_URL=http://localhost:5172

# --- Omnivoice ---
# Token Hugging Face pour télécharger le modèle
HF_TOKEN=hf_votre_token
